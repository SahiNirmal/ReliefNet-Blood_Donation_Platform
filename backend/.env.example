# Copy this file to .env and fill in your own values.
#
# Local MongoDB:   mongodb://127.0.0.1:27017/reliefnet
# MongoDB Atlas:   paste your connection string and ADD a database name
#                  right after the host, before the "?" — Atlas's copied
#                  string usually ends in a bare "/", which makes Mongoose
#                  default to a database literally called "test".
#                  e.g. mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/reliefnet?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/reliefnet

PORT=5000

# The exact origin your frontend runs on (protocol + host + port, no
# trailing slash). Locks CORS down to just this origin. If left unset,
# CORS falls back to allowing any origin — fine for local development,
# but always set this in production.
FRONTEND_URL=http://localhost:5173

# Secret used to sign/verify JWTs. Generate a long random value for real
# use — never commit a real one. Quick way to generate one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-this-with-a-long-random-string
JWT_EXPIRES_IN=7d
